PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Base de datos MySQL 8
DATABASE_URL="mysql://satem_user:satem_password@satem-control-db:3306/satem_control_db"

# Secretos JWT & Cookies
JWT_SECRET="CHANGE_ME_JWT_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_JWT_REFRESH_SECRET"
COOKIE_SECRET="CHANGE_ME_COOKIE_SECRET"

# Storage local/persistente
STORAGE_PATH="/app/storage"

# Frontend URL para CORS
FRONTEND_URL="https://satem-control.yourdomain.com"
