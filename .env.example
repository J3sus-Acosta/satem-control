# SATEM CONTROL V1 — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO GIT!

# Environment & Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Connection (MySQL 8.0)
DB_HOST=satem-control-db
DB_PORT=3306
DB_NAME=satem_control_db
DB_USER=satem_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Authentication & JWT Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_SECRET_MIN_32_CHARS
COOKIE_SECRET=YOUR_SECURE_COOKIE_SECRET_MIN_32_CHARS

# Almacenamiento Persistente
STORAGE_PATH=/app/storage
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# EasyPanel / Traefik Service Domains
FRONTEND_URL=https://app.satem.cl
VITE_API_URL=https://api.satem.cl
